    {
      "itemId": "binary-search-complexity",
      "prompt": "要素数nの整列済み配列を二分探索するとき、最悪比較回数のオーダーは何ですか？",
      "answer": "O(log n)です。",
      "explanation": "比較するたびに残りの探索範囲をおよそ半分にできます。",
      "activities": [{ "activityId": "recall", "kind": "recall" }]
    },
